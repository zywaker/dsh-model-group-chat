{
    "name":  "dsh-model-group-chat",
    "version":  "1.24.0",
    "description":  "Multiple DSH models discuss one question together: independent answers, optional summary, free discussion, approved file access, paged reads of Office/PDF/image files, and chat attachments.",
    "license":  "MIT",
    "type":  "module",
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "dsh-plugin",
                     "group-chat",
                     "multi-model",
                     "plugin"
                 ],
    "engines":  {
                    "dsh":  "0.2.2-rc.5"
                },
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "host.js",
                  "engine.js",
                  "project-files.js",
                  "project-overview.js",
                  "project-access.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md",
                  "extract.js"
              ],
    "scripts":  {
                    "test":  "node --test"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-layout",
                                              "@deepseek-ai/dsh-client-ui-sidebar",
                                              "@deepseek-ai/dsh-client-ui-workspace",
                                              "@deepseek-ai/dsh-client-ui-chat"
                                          ]
                           }
            }
}